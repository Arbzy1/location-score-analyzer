{
  "name": "location-score-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:transit": "node scripts/build-transit.mjs",
    "build:client": "npm --prefix ../client install && npm --prefix ../client run build",
    "dev": "wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neondatabase/serverless": "^1.2.0",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.156.2"
  }
}

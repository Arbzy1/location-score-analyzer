{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "location-score-analyzer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",

  // The React app (built into ../client/dist) is served from the same Worker,
  // so the browser talks to /api on the same origin - no CORS, no hard-coded IPs.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    // Firebase is only used for Google sign-in; user data lives in Neon.
    "FIREBASE_PROJECT_ID": "streetnetworkanalysis",
    // Sent to Nominatim/Overpass as required by their usage policies.
    "CONTACT": "https://github.com/"
  },

  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   DATABASE_URL - Neon connection string (optional: without it there is no caching or saved data)
  //   ORS_API_KEY  - openrouteservice.org key (optional: without it travel times are estimated)

  "observability": { "enabled": true }
}
